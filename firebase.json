{
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "trailingSlash": true,
    "rewrites": [
      {
        "source": "/refer",
        "destination": "/refer/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/privacy-policy",
        "destination": "https://plannexttech-cmd.github.io/planbot07/PlanBot-Privacy-Policy.html",
        "type": 301
      },
      {
        "source": "/terms",
        "destination": "https://plannexttech-cmd.github.io/planbot07/PlanBot-terms.html",
        "type": 301
      },
      {
        "source": "/refund-policy",
        "destination": "https://plannexttech-cmd.github.io/planbot07/PlanBot-refund.html",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          }
        ]
      }
    ]
  }
}
