e":"text-xs text-text-dim text-center md:text-right","children":["PlanBot is an Android app. Download from"," ",["$","$L7",null,{"location":"footer","className":"text-accent hover:underline","children":"Google Play"}],"."]}]]}]]}]}],["$","$Lf",null,{"gaId":"G-0Y5H7R0D6Z"}],["$","$L10",null,{"id":"microsoft-clarity","strategy":"afterInteractive","children":"\n            (function(c,l,a,r,i,t,y){\n                c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};\n                t=l.createElement(r);t.async=1;t.src=\"https://www.clarity.ms/tag/\"+i;\n                y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);\n            })(window, document, \"clarity\", \"script\", \"x7grrxn17q\");\n          "}]]}]]}]],null],null],["$L11",null]]]]
4:[["$","div",null,{"className":"aeo-answer tl-dr","children":["$","p",null,{"children":[["$","strong",null,{"children":"Quick Answer:"}]," The JEE 2027 plan runs in four exam-anchored phases: Foundation (Oct-Jan, close Class 11 gaps + current Class 12 topics, ending with the January Session 1 as a diagnostic), Integration (Feb-Mar, finish the syllabus + previous year questions), Test Season (Apr, full mocks twice weekly before the April Session 2), and Advanced Push (the final 6-8 weeks before Advanced in May-June). Started in October that is about 9 focused months; start earlier and you stretch Foundation - the structure never changes. Study 4-6 focused hours daily as a school student, keep one weekly test-analysis day from week one, and let an AI planner handle daily rebalancing."]}]}],"\n",["$","h2",null,{"children":"Who This Plan Is For"}],"\n",["$","p",null,{"children":"This calendar is built for two profiles:"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Class 12 students (2026-27 batch)"}]," writing JEE Main in January/April 2027 while managing boards"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Droppers"}]," starting a dedicated 12-month cycle from October 2026"]}],"\n"]}],"\n",["$","p",null,{"children":["If you are in Class 11 right now and targeting JEE 2028, use this as a preview of your final year, not your current schedule. (We already have a guide on ",["$","a",null,{"href":"/blog/how-to-create-jee-study-plan-with-ai","children":"creating a JEE study plan with AI"}]," that covers the earlier foundation years.)"]}],"\n",["$","h2",null,{"children":"The Four Phases at a Glance"}],"\n",["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Phase"}],["$","th",null,{"children":"Window (2026-27)"}],["$","th",null,{"children":"Focus"}],["$","th",null,{"children":"Mock tests"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":"1. Foundation"}],["$","td",null,{"children":"Oct - Jan"}],["$","td",null,{"children":"Class 11 backlog + running Class 12 syllabus"}],["$","td",null,{"children":"Chapter tests weekly; Session 1 (late Jan) as a diagnostic if you attempt it"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"2. Integration"}],["$","td",null,{"children":"Feb - Mar"}],["$","td",null,{"children":"Finish Class 12 syllabus, start PYQs chapter-wise"}],["$","td",null,{"children":"1 full mock every 2 weeks"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"3. Test Season"}],["$","td",null,{"children":"Apr - May (run-up to Session 2)"}],["$","td",null,{"children":"Revision cycles + mock frequency doubles"}],["$","td",null,{"children":"2 full mocks weekly + same-day analysis"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"4. Advanced Push"}],["$","td",null,{"children":"Final 6-8 weeks before Advanced"}],["$","td",null,{"children":"Olympiad-level problems, weak-area surgery, formula sheets"}],["$","td",null,{"children":"3 mocks weekly, all Advanced-pattern"}]]}]]}]]}],"\n",["$","p",null,{"children":["Wait - the exam windows. JEE Main Session 1 has historically landed in ",["$","strong",null,{"children":"late January"}]," and Session 2 in ",["$","strong",null,{"children":"April"}],", with JEE Advanced in ",["$","strong",null,{"children":"May-June"}],". The 2027 notification is not out as I write this, so treat those as expected windows and confirm with the official NTA announcement. The plan below anchors to them."]}],"\n",["$","p",null,{"children":"Two starting points, one structure: a dropper starting in October gets roughly 9 focused months, and a school student who began after their boards in April gets the full 12. Starting later than October? Compress Phase 1 to six weeks by narrowing backlog scope - never by deleting the weekly test day."}],"\n",["$","h2",null,{"children":"Phase 1: Foundation (Oct - Jan)"}],"\n",["$","p",null,{"children":"The single biggest rank-killer at this stage is carrying Class 11 gaps into Class 12 topics, because JEE papers freely mix both years. So the first 16 weeks run a dual track."}],"\n",["$","p",null,{"children":["$","strong",null,{"children":"Weekly template (Mon-Sat):"}]}],"\n",["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Day"}],["$","th",null,{"children":"Morning block (2-2.5 h)"}],["$","th",null,{"children":"Evening block (2-2.5 h)"}],["$","th",null,{"children":"Night (45 min)"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":"Mon"}],["$","td",null,{"children":"Maths - current Class 12 topic"}],["$","td",null,{"children":"Physics - Class 11 backlog chapter"}],["$","td",null,{"children":"Formula flash review"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Tue"}],["$","td",null,{"children":"Chemistry - Physical (current)"}],["$","td",null,{"children":"Maths - DPP of Monday's topic"}],["$","td",null,{"children":"Flashcards"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Wed"}],["$","td",null,{"children":"Physics - current topic"}],["$","td",null,{"children":"Chemistry - Organic (Class 11 backlog)"}],["$","td",null,{"children":"Formula flash review"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Thu"}],["$","td",null,{"children":"Maths - current + mixed problems"}],["$","td",null,{"children":"Physics - DPP + notes"}],["$","td",null,{"children":"Flashcards"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Fri"}],["$","td",null,{"children":"Chemistry - Organic/Inorganic (current)"}],["$","td",null,{"children":"Maths - Class 11 backlog chapter"}],["$","td",null,{"children":"Formula flash review"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Sat"}],["$","td",null,{"children":"Weekly cumulative test (3 h, timed)"}],["$","td",null,{"children":"Full error analysis, re-solve every wrong question"}],["$","td",null,{"children":"Plan next week"}]]}],["$","tr",null,{"children":[["$","td",null,{"children":"Sun"}],["$","td",null,{"children":"Buffer: backlog clearance, sleep recovery, light revision"}],["$","td",null,{}],["$","td",null,{}]]}]]}]]}],"\n",["$","p",null,{"children":"Rules that make Phase 1 work:"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Never skip Saturday's test."}]," Chapter-wise tests from week one build exam temperament months before your first mock."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Backlog is a scheduled subject"}],", not guilt. Two evening blocks per week are reserved for it until it is gone."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Coaching/class homework merges into the evening block"}]," - do not double-plan. One calendar, one source of truth."]}],"\n"]}],"\n",["$","h2",null,{"children":"Phase 2: Integration (Feb - Mar)"}],"\n",["$","p",null,{"children":"Syllabus completion by the end of Month 7, with previous year questions entering the bloodstream:"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Every finished chapter immediately gets its PYQ set"}]," (last 10 years, chapter-wise). Knowledge that has never faced a JEE question is not JEE-ready knowledge."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Fortnightly full mocks begin"}]," - yes, on an incomplete syllabus. Early mocks expose pacing problems while there is still time to fix them."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Short notes per chapter"}],": one page of formulas, traps, and \"my mistakes.\" These become your revision fuel in Phase 3."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Chemistry Inorganic + Biology-adjacent memorization loads shift to night blocks"}],", when active recall beats problem-solving."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Late January = Session 1."}]," Take it if you are registered - a full-dress diagnostic, not the final verdict. A large number of top-500 scorers improve their rank massively in Session 2 - do not treat January as pass/fail."]}],"\n"]}],"\n",["$","h2",null,{"children":"Phase 3: Test Season (Apr - May)"}],"\n",["$","p",null,{"children":"This is where the plan turns from learning to scoring:"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Two full-length mocks per week"}]," (Session-1 pattern), taken at the actual exam time slot so your brain learns the rhythm."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Same-day analysis, always"}],": every wrong answer gets a category - concept gap, silly mistake, or time pressure - and the category decides the fix."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Revision cycles run on your short notes"}],", not textbooks. Three full cycles across these months."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Between sessions (Feb-Mar):"}]," rebuild weak chapters flagged by mock data, keep one mock weekly, then ramp to two before Session 2 in April."]}],"\n"]}],"\n",["$","h2",null,{"children":"Phase 4: Advanced Push (Final 6-8 Weeks)"}],"\n",["$","p",null,{"children":"JEE Advanced rewards depth over coverage:"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":["Switch two of three weekly mocks to ",["$","strong",null,{"children":"Advanced pattern"}]," (Paper 1 + Paper 2 format, multi-concept problems)."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Problem quality over quantity"}],": Olympiad-style sets, matrix-match, paragraph-based questions."]}],"\n",["$","li",null,{"children":"No new topics in the last 3 weeks. Only your notes, your error log, and your mocks."}],"\n",["$","li",null,{"children":"Sleep schedule locked to exam-slot wake times, 10 days out."}],"\n"]}],"\n",["$","h2",null,{"children":"Where AI Planning Fits (Without Guilt)"}],"\n",["$","p",null,{"children":["A 12-month plan sounds clean in a table. In real life: school exams, coaching tests, a bad week of health, a chapter that refuses to click. The plan survives only if it ",["$","em",null,{"children":"adapts"}]," - and daily manual re-planning is exactly what students stop doing by November."]}],"\n",["$","p",null,{"children":["That is the actual job an AI planner takes over. In ",["$","a",null,{"href":"https://play.google.com/store/apps/details?id=cpm.planbot","children":"PlanBot"}],", you set the JEE 2027 goal once; every morning the day is regenerated around what you actually completed, weak chapters get heavier blocks automatically, and mock dates sit in the calendar where they belong. Your job reduces to executing the day and telling the truth about it."]}],"\n",["$","p",null,{"children":["Use the free ",["$","a",null,{"href":"/tools/exam-revision-calculator","children":"Exam Revision Calculator"}]," to sanity-check your phase split before you commit to it."]}],"\n",["$","h2",null,{"children":"The Honest Part"}],"\n",["$","p",null,{"children":"No plan - this one included - clears JEE for you. What a plan does is remove the daily \"what should I study now?\" decision, which quietly costs 30-60 minutes and a chunk of willpower every single day. Twelve months of decided mornings is the actual strategy. Everything else is details."}],"\n",["$","hr",null,{}],"\n",["$","p",null,{"children":["$","em",null,{"children":["Want this calendar to run itself day to day? ",["$","a",null,{"href":"https://play.google.com/store/apps/details?id=cpm.planbot","children":"Download PlanBot free on Android"}]," - AI daily planning built for JEE, NEET, and competitive exams."]}]}]]
