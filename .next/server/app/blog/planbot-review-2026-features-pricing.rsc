dren":"3-day free trial"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"—"}],["$","td",null,{"children":"—"}]]}]]}]]}],"\n",["$","h3",null,{"children":"Value Assessment:"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Free:"}]," Perfect for trying the app. 2 plans/day with Basic AI is functional for basic planning."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Pro (₹99/mo):"}]," Best value for students. Removes ads and upgrades to a more powerful AI engine. At ₹99, this is cheaper than a single coffee at Starbucks."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Elite (₹129/mo):"}]," Best for serious goal-chasers who want weekly AI reports and the Advanced AI engine."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"God (₹249/mo):"}]," Best for power users. Unlimited plans with our most powerful AI + weekly reports + priority support. This is premium, and it should be."]}],"\n"]}],"\n",["$","h2",null,{"children":"Pros and Cons"}],"\n",["$","h3",null,{"children":"✅ Pros"}],"\n",["$","ol",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"AI actually works"}]," — Plans are genuinely useful, not gimmicky"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Streaks are addictive"}]," — The #1 reason users stick with the app"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Affordable"}]," — ₹99-249/month is accessible for most Indian users"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Multiple AI models"}]," — Choose the AI that fits your needs and budget"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Gamification"}]," — XP, levels, and achievements make productivity fun"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Clean UI"}]," — Dark theme, smooth animations, professional design"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Indian-made"}]," — Pricing in ₹, UPI-friendly, exam-specific personas"]}],"\n"]}],"\n",["$","h3",null,{"children":"❌ Cons"}],"\n",["$","ol",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Android only"}]," — No iOS or web version (yet)"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"No calendar sync"}]," — Can't auto-import Google Calendar events"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Offline limitations"}]," — AI plan generation needs internet"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Weekly reports gated"}]," — Only Elite and God tiers get performance analytics"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"No team features"}]," — Individual use only, no shared plans"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Young app"}]," — Still building features; some polish areas remain"]}],"\n"]}],"\n",["$","h2",null,{"children":"Who Should Use PlanBot?"}],"\n",["$","h3",null,{"children":"Best For:"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"✅ Students preparing for JEE, NEET, GATE, UPSC"}],"\n",["$","li",null,{"children":"✅ Working professionals seeking structured daily routines"}],"\n",["$","li",null,{"children":"✅ Athletes and fitness enthusiasts with training goals"}],"\n",["$","li",null,{"children":"✅ Entrepreneurs managing complex multi-priority schedules"}],"\n",["$","li",null,{"children":"✅ Anyone who struggles with planning and procrastination"}],"\n",["$","li",null,{"children":"✅ People who respond to gamification and streaks"}],"\n"]}],"\n",["$","h3",null,{"children":"Not Ideal For:"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"❌ Teams needing shared project management (use Asana/Linear)"}],"\n",["$","li",null,{"children":"❌ iOS users (app not available on iPhone)"}],"\n",["$","li",null,{"children":"❌ Users who need offline-first functionality"}],"\n",["$","li",null,{"children":"❌ People who prefer 100% manual control over their schedule"}],"\n"]}],"\n",["$","h2",null,{"children":"The Bottom Line"}],"\n",["$","p",null,{"children":["PlanBot represents a ",["$","strong",null,{"children":"genuine innovation"}]," in the productivity app space. It's not just another to-do app with an AI label slapped on — the AI planning actually works, the gamification keeps you coming back, and the pricing is fair for Indian users."]}],"\n",["$","p",null,{"children":["$","strong",null,{"children":"Our Rating: 4.3/5 ⭐"}]}],"\n",["$","p",null,{"children":"The app loses points for being Android-only and lacking calendar sync, but gains full marks for its AI quality, streak system, and value-for-money pricing."}],"\n",["$","p",null,{"children":"If you've ever struggled with \"I know what I should do, I just can't plan it\" — PlanBot is your answer."}],"\n",["$","h2",null,{"children":"Frequently Asked Questions"}],"\n",["$","p",null,{"children":[["$","strong",null,{"children":"Q: Is PlanBot worth paying for?"}]," A: The Free tier is fully functional for basic planning. If you want better AI, no ads, and weekly reports, the paid tiers offer genuine value. Pro at ₹99/mo is an easy recommendation."]}],"\n",["$","p",null,{"children":[["$","strong",null,{"children":"Q: How does PlanBot compare to Motion or Reclaim?"}]," A: Motion and Reclaim are US-focused, web-first, and expensive ($19-34/month USD). PlanBot is India-focused, mobile-first, and affordable (₹99-249/month). PlanBot also has gamification (streaks, XP), which Motion and Reclaim lack."]}],"\n",["$","p",null,{"children":[["$","strong",null,{"children":"Q: Is PlanBot safe? Does it store my data?"}]," A: PlanBot processes your goals through cloud AI models. Check the app's privacy policy for specific data handling details. The app doesn't require access to contacts, photos, or sensitive permissions."]}],"\n",["$","p",null,{"children":[["$","strong",null,{"children":"Q: Can I cancel my PlanBot subscription anytime?"}]," A: Yes. PlanBot subscriptions are managed through Google Play Store. You can cancel anytime, and you'll retain access until the end of your billing period."]}],"\n",["$","p",null,{"children":[["$","strong",null,{"children":"Q: When will PlanBot come to iOS?"}]," A: PlanBot is currently Android only. Check the app's social media or this website for iOS development updates."]}],"\n",["$","hr",null,{}],"\n",["$","p",null,{"children":["$","em",null,{"children":["See for yourself. ",["$","a",null,{"href":"https://play.google.com/store/apps/details?id=cpm.planbot","children":"Download PlanBot free"}]," and experience AI-powered daily planning."]}]}]]
