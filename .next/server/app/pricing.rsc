4:T613,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"How does the tier progression work?","acceptedAnswer":{"@type":"Answer","text":"Each tier level permanently upgrades your planning history limit (from 3 plans on Free up to 100 plans on God tier), expands your analytics scope (from Today focus up to Diurnal peak study time & Heatmap), and unlocks active goal slots and advanced AI features."}},{"@type":"Question","name":"How does the God Trial work?","acceptedAnswer":{"@type":"Answer","text":"You get 3 days of full God tier features (100-plan history, Diurnal distribution, Peer Benchmarks, Study Pattern AI, unlimited goals) completely free. No credit card needed. Download the app to activate."}},{"@type":"Question","name":"How much do the paid tiers cost in INR?","acceptedAnswer":{"@type":"Answer","text":"PlanBot Pro is ₹99/month. Elite is ₹129/month. God tier is ₹249/month. You can also save 30% by choosing yearly billing."}},{"@type":"Question","name":"Can I cancel anytime?","acceptedAnswer":{"@type":"Answer","text":"Yes. Manage your subscription through Google Play at any time with zero cancellation fees."}},{"@type":"Question","name":"Can I use PlanBot on iPhone?","acceptedAnswer":{"@type":"Answer","text":"PlanBot is currently Android only. iOS support is planned for the future."}},{"@type":"Question","name":"Is there a refund policy?","acceptedAnswer":{"@type":"Answer","text":"Yes. All Google Play standard refund policies apply. View our full refund policy page for details."}}]}7:T668,{"@context":"https://schema.org","@type":"Organization","@id":"https://planbotai.app/#organization","name":"PlannextTech","alternateName":"PlanBot Team","url":"https://planbotai.app","areaServed":{"@type":"Country","name":"Worldwide"},"logo":"https://planbotai.app/android-chrome-512x512.png","description":"PlannextTech builds advanced AI productivity tools and scheduling systems for ambitious individuals. PlanBot is our flagship AI d